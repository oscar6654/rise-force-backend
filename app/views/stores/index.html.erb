<% content_for :page_title, "Store master" %>
<% content_for :page_actions do %>
  <% if can?(:store, :create) %>
    <%= link_to "↑ Bulk upload", new_import_path("stores"), class: "rounded-md border border-slate-300 bg-white text-slate-700 text-sm font-semibold px-3 py-2 hover:bg-slate-50" %>
    <%= link_to "New store", new_store_path, class: "rounded-md bg-[#1f4b99] text-white text-sm font-semibold px-3 py-2 hover:bg-[#17386f]" %>
  <% end %>
<% end %>

<div class="rounded-xl border border-slate-200 bg-white overflow-hidden">
  <%= form_with url: stores_path, method: :get, local: true, class: "px-4 py-3 border-b border-slate-200 flex flex-wrap items-center gap-2" do %>
    <%= text_field_tag :q, params[:q], placeholder: "Search code, name, owner…", class: "flex-1 min-w-[200px] rounded-md border border-slate-300 px-3 py-2 text-sm" %>
    <%= select_tag :channel_id, options_from_collection_for_select(Channel.order(:name), :id, :name, params[:channel_id]).prepend(content_tag(:option, "All channels", value: "")), class: "rounded-md border border-slate-300 px-2 py-2 text-sm" %>
    <%= select_tag :category, options_for_select([["All categories", ""]] + StoreCategory.ordered.map { |c| [c.label, c.id] }, params[:category]), class: "rounded-md border border-slate-300 px-2 py-2 text-sm" %>
    <%= select_tag :seller_id, options_for_select([["All sellers", ""]] + Seller.order(:name).map { |s| [s.name, s.id] }, params[:seller_id]), class: "rounded-md border border-slate-300 px-2 py-2 text-sm", data: { controller: "tom-select" } %>
    <%= submit_tag "Filter", class: "rounded-md border border-slate-300 text-sm px-3 py-2 hover:bg-slate-50 cursor-pointer" %>
    <span class="text-xs text-slate-500 ml-auto"><%= @stores.total_count %> stores</span>
  <% end %>

  <div class="overflow-x-auto">
    <table class="w-full border-collapse min-w-[940px]">
      <thead><tr class="bg-slate-50 border-b border-slate-200 text-left text-[11px] uppercase tracking-wide text-slate-500">
        <th class="px-4 py-2.5">Code</th><th class="px-4 py-2.5">Store</th><th class="px-4 py-2.5">Channel</th>
        <th class="px-4 py-2.5">Category</th><th class="px-4 py-2.5">Seller</th><th class="px-4 py-2.5">Route · freq</th><th class="px-4 py-2.5">Status</th><th></th>
      </tr></thead>
      <tbody>
        <% @stores.each do |s| %>
          <tr class="border-b border-slate-100 hover:bg-slate-50">
            <td class="px-4 py-3 font-mono text-xs text-slate-600 whitespace-nowrap"><%= s.code %></td>
            <td class="px-4 py-3"><div class="text-sm font-medium"><%= link_to s.name, store_path(s), class: "text-[#1f4b99] hover:underline" %></div><div class="text-xs text-slate-500"><%= s.address %></div></td>
            <td class="px-4 py-3 text-sm text-slate-600 whitespace-nowrap"><%= s.channel&.name %></td>
            <td class="px-4 py-3 whitespace-nowrap"><% if s.store_category %><span class="rounded bg-slate-100 text-slate-700 text-[11px] font-semibold px-2 py-0.5"><%= s.store_category.label %></span><% end %></td>
            <td class="px-4 py-3 text-sm text-slate-600 whitespace-nowrap"><%= s.assigned_seller&.name || "—" %></td>
            <td class="px-4 py-3 text-sm text-slate-600 whitespace-nowrap"><%= s.route&.code || "—" %> · <span class="font-semibold text-slate-800"><%= s.visit_frequency&.upcase %></span></td>
            <td class="px-4 py-3 whitespace-nowrap"><span class="rounded-full text-[11px] font-semibold px-2 py-0.5 <%= s.active? ? 'bg-emerald-100 text-emerald-700' : s.provisional? ? 'bg-amber-100 text-amber-700' : 'bg-slate-100 text-slate-600' %>"><%= s.status.titleize %></span></td>
            <td class="px-4 py-3 text-right whitespace-nowrap">
              <%= link_to "View", store_path(s), class: "text-sm font-semibold text-slate-600 hover:underline mr-3" %>
              <% if can?(:store, :update) %><%= link_to "Edit", edit_store_path(s), class: "text-sm font-semibold text-[#1f4b99] hover:underline" %><% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
  <div class="px-4 py-3"><%= paginate @stores if respond_to?(:paginate) %></div>
</div>
