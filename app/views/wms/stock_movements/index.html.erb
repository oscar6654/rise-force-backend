<% content_for :page_title, "Stock ledger" %>
<% content_for :page_actions do %>
  <%= link_to "Download CSV", export_path("stock_movements", params.permit(:warehouse_id, :movement_type, :staff_code, :from, :to)), class: "rounded-md border border-slate-300 text-sm font-semibold px-3 py-2 hover:bg-slate-50" if can?(:stock_movement, :download) %>
<% end %>

<form class="mb-3 flex flex-wrap gap-2 items-center" method="get">
  <%= select_tag :warehouse_id, options_from_collection_for_select(@warehouses, :id, :whs_code, params[:warehouse_id]), include_blank: "All warehouses", class: "rounded-md border border-slate-300 px-3 py-2 text-sm", onchange: "this.form.submit()" %>
  <%= select_tag :movement_type, options_for_select(StockMovement.movement_types.keys.map { |s| [s.titleize, s] }, params[:movement_type]), include_blank: "All types", class: "rounded-md border border-slate-300 px-3 py-2 text-sm", onchange: "this.form.submit()" %>
  <%= text_field_tag :staff_code, params[:staff_code], placeholder: "Staff code", class: "rounded-md border border-slate-300 px-3 py-2 text-sm w-32" %>
  <label class="text-xs text-slate-500">From <%= date_field_tag :from, params[:from], class: "rounded-md border border-slate-300 px-2 py-2 text-sm", onchange: "this.form.submit()" %></label>
  <label class="text-xs text-slate-500">To <%= date_field_tag :to, params[:to], class: "rounded-md border border-slate-300 px-2 py-2 text-sm", onchange: "this.form.submit()" %></label>
  <%= submit_tag "Apply", class: "rounded-md bg-slate-800 text-white text-sm font-semibold px-3 py-2 hover:bg-slate-700 cursor-pointer" %>
  <% if params[:warehouse_id].present? || params[:movement_type].present? || params[:staff_code].present? || params[:from].present? || params[:to].present? %>
    <%= link_to "Clear", url_for(controller: "wms/stock_movements", action: "index"), class: "text-sm text-slate-500 underline" %>
  <% end %>
</form>

<div class="rounded-xl border border-slate-200 bg-white overflow-hidden">
  <table class="w-full border-collapse min-w-[820px]">
    <thead><tr class="bg-slate-50 border-b border-slate-200 text-left text-[11px] uppercase tracking-wide text-slate-500">
      <th class="px-3 py-2.5">When</th><th class="px-3 py-2.5">WH</th><th class="px-3 py-2.5">Type</th><th class="px-3 py-2.5">Field</th>
      <th class="px-3 py-2.5 text-right">Qty</th><th class="px-3 py-2.5">SKU</th><th class="px-3 py-2.5">Location</th><th class="px-3 py-2.5">Staff</th><th class="px-3 py-2.5">Reason</th>
    </tr></thead>
    <tbody>
      <% @movements.each do |m| %>
        <tr class="border-b border-slate-100">
          <td class="px-3 py-2 text-xs text-slate-500"><%= m.occurred_at&.strftime("%d %b %H:%M") %></td>
          <td class="px-3 py-2 text-xs text-slate-500"><%= m.warehouse.whs_code %></td>
          <td class="px-3 py-2 text-xs"><%= m.movement_type.titleize %></td>
          <td class="px-3 py-2 text-xs text-slate-500"><%= m.field %></td>
          <td class="px-3 py-2 text-right text-sm <%= m.quantity.negative? ? 'text-red-600' : 'text-emerald-700' %>"><%= m.quantity.to_i %></td>
          <td class="px-3 py-2 font-mono text-xs"><%= m.product&.sku %></td>
          <td class="px-3 py-2 font-mono text-xs"><%= m.storage_location&.loc_code %><%= " → #{m.to_storage_location.loc_code}" if m.to_storage_location %></td>
          <td class="px-3 py-2 text-xs text-slate-500"><%= m.warehouse_staff&.staff_code || (m.user && "#{m.user.email} (office)") %></td>
          <td class="px-3 py-2 text-xs text-slate-500"><%= m.reason %></td>
        </tr>
      <% end %>
      <% if @movements.empty? %><tr><td colspan="9" class="px-4 py-8 text-center text-sm text-slate-500">No movements yet.</td></tr><% end %>
    </tbody>
  </table>
</div>
<div class="mt-3"><%= paginate @movements if respond_to?(:paginate) %></div>
