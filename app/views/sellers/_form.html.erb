<%= form_with model: seller, local: true do |f| %>
  <%= render "shared/form_errors", model: seller %>
  <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
    <div>
      <%= f.label :seller_code, class: "block text-sm font-medium text-slate-700 mb-1" %>
      <%= f.text_field :seller_code, class: "w-full rounded-md border border-slate-300 px-3 py-2 text-sm" %>
    </div>
    <div>
      <%= f.label :name, class: "block text-sm font-medium text-slate-700 mb-1" %>
      <%= f.text_field :name, class: "w-full rounded-md border border-slate-300 px-3 py-2 text-sm" %>
    </div>
    <% if current_user.all_branches? %>
      <div>
        <%= f.label :branch_id, "Branch", class: "block text-sm font-medium text-slate-700 mb-1" %>
        <%= f.collection_select :branch_id, Branch.order(:name), :id, :name, {}, class: "w-full rounded-md border border-slate-300 px-3 py-2 text-sm" %>
      </div>
    <% end %>
    <div>
      <%= f.label :status, class: "block text-sm font-medium text-slate-700 mb-1" %>
      <%= f.select :status, Seller.statuses.keys.map { |s| [s.titleize, s] }, {}, class: "w-full rounded-md border border-slate-300 px-3 py-2 text-sm" %>
    </div>
    <div>
      <%= f.label :device_id, "Device ID", class: "block text-sm font-medium text-slate-700 mb-1" %>
      <%= f.text_field :device_id, class: "w-full rounded-md border border-slate-300 px-3 py-2 text-sm" %>
    </div>
    <div>
      <%= f.label :pin, "Mobile PIN", class: "block text-sm font-medium text-slate-700 mb-1" %>
      <%= f.password_field :pin, autocomplete: "new-password", placeholder: (f.object.pin_set? ? "•••• (set — leave blank to keep)" : "Set a PIN for the app"), class: "w-full rounded-md border border-slate-300 px-3 py-2 text-sm" %>
      <p class="text-[11px] text-slate-400 mt-1">The seller signs into the Rise Force app with their seller code + this PIN.</p>
    </div>

    <div class="md:col-span-2 rounded-lg border border-slate-200 bg-slate-50 p-3">
      <div class="text-xs font-semibold text-slate-600 mb-2">Diser login (optional) — a stock-check-only helper on this seller's stores</div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-3">
        <div>
          <%= f.label :diser_code, "Diser code", class: "block text-sm font-medium text-slate-700 mb-1" %>
          <%= f.text_field :diser_code, placeholder: "e.g. DSR-538614", class: "w-full rounded-md border border-slate-300 px-3 py-2 text-sm" %>
        </div>
        <div>
          <%= f.label :diser_name, "Diser name", class: "block text-sm font-medium text-slate-700 mb-1" %>
          <%= f.text_field :diser_name, class: "w-full rounded-md border border-slate-300 px-3 py-2 text-sm" %>
        </div>
        <div>
          <%= f.label :diser_pin, "Diser PIN", class: "block text-sm font-medium text-slate-700 mb-1" %>
          <%= f.password_field :diser_pin, autocomplete: "new-password", placeholder: (f.object.diser_pin_set? ? "•••• (set — blank to keep)" : "Set a PIN"), class: "w-full rounded-md border border-slate-300 px-3 py-2 text-sm" %>
        </div>
      </div>
      <p class="text-[11px] text-slate-400 mt-1">Leave the code blank for no diser login. The diser signs in with this code + PIN and only sees stock check (scan + submit), offline. Their counts feed the same inventory/ICO engine but never affect coverage.</p>
    </div>

    <div class="md:col-span-2">
      <%= f.label :primary_seller_id, "Login group — primary seller (optional)", class: "block text-sm font-medium text-slate-700 mb-1" %>
      <%= f.collection_select :primary_seller_id,
            Seller.where.not(id: f.object.id).where(primary_seller_id: nil).order(:name), :id, :name,
            { include_blank: "— this is its own login —" },
            class: "w-full rounded-md border border-slate-300 px-3 py-2 text-sm", data: { controller: "tom-select", "tom-select-placeholder-value": "Search sellers…" } %>
      <p class="text-[11px] text-slate-400 mt-1">For a rep covering 2 branches with 2 vcsi codes: keep one seller as the login and point the extra record(s) here. One app login then sees BOTH branches' stores &amp; combined sales; each record keeps its own rep code &amp; sync.</p>
    </div>

    <div>
      <%= f.label :vcsi_sales_rep_ref, "vcsi_rise sales rep code", class: "block text-sm font-medium text-slate-700 mb-1" %>
      <%= f.text_field :vcsi_sales_rep_ref, placeholder: "e.g. 538614", class: "w-full rounded-md border border-slate-300 px-3 py-2 text-sm" %>
      <p class="text-[11px] text-slate-400 mt-1">Join key to vcsi_rise sellout & targets (sales_rep code).</p>
    </div>
    <% if f.object.persisted? && f.object.managers.any? %>
      <div class="md:col-span-2 text-xs text-slate-500">
        Field managers overseeing this seller: <span class="font-medium text-slate-700"><%= f.object.managers.map(&:name).join(", ") %></span>
        (assign on the <%= link_to "managers page", managers_path, class: "text-[#1f4b99] hover:underline" %>).
      </div>
    <% end %>
    <div>
      <%= f.label :user_id, "Assigned console user", class: "block text-sm font-medium text-slate-700 mb-1" %>
      <%= f.collection_select :user_id, User.order(:first_name), :id, :full_name, { include_blank: "— none —" },
            class: "w-full rounded-md border border-slate-300 px-3 py-2 text-sm", data: { controller: "tom-select", "tom-select-placeholder-value": "Search users…" } %>
    </div>
    <div>
      <%= f.label :supervisor_name, "Supervisor", class: "block text-sm font-medium text-slate-700 mb-1" %>
      <%= f.text_field :supervisor_name, class: "w-full rounded-md border border-slate-300 px-3 py-2 text-sm" %>
    </div>
    <div>
      <%= f.label :gsm_name, "GSM", class: "block text-sm font-medium text-slate-700 mb-1" %>
      <%= f.text_field :gsm_name, class: "w-full rounded-md border border-slate-300 px-3 py-2 text-sm" %>
    </div>
    <div>
      <%= f.label :om_name, "OM", class: "block text-sm font-medium text-slate-700 mb-1" %>
      <%= f.text_field :om_name, class: "w-full rounded-md border border-slate-300 px-3 py-2 text-sm" %>
    </div>
    <div>
      <%= f.label :sales_target, "Sales target", class: "block text-sm font-medium text-slate-700 mb-1" %>
      <%= f.number_field :sales_target, step: "0.01", class: "w-full rounded-md border border-slate-300 px-3 py-2 text-sm" %>
    </div>
  </div>
  <div class="mt-5 flex items-center gap-2">
    <%= f.submit(seller.persisted? ? "Save changes" : "Create seller", class: "rounded-md bg-[#1f4b99] text-white text-sm font-semibold px-4 py-2 hover:bg-[#17386f] cursor-pointer") %>
    <%= link_to "Cancel", sellers_path, class: "text-sm text-slate-500 hover:underline px-2" %>
  </div>
<% end %>
