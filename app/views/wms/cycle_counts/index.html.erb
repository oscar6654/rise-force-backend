<% content_for :page_title, "Cycle counts (IRA)" %>
<% content_for :page_actions do %>
  <%= link_to "Open a count", new_wms_cycle_count_path, class: "rounded-md bg-[#1f4b99] text-white text-sm font-semibold px-3 py-2 hover:bg-[#17386f]" if can?(:cycle_count, :create) %>
<% end %>

<% if @ira %>
  <div class="mb-4 rounded-xl border border-slate-200 bg-white px-4 py-3 text-sm">Inventory Record Accuracy (IRA): <strong class="text-lg"><%= @ira %>%</strong> <span class="text-slate-500">of reconciled counts matched the system exactly.</span></div>
<% end %>

<form class="mb-3 flex gap-2" method="get">
  <%= select_tag :warehouse_id, options_from_collection_for_select(@warehouses, :id, :whs_code, params[:warehouse_id]), include_blank: "All WMS warehouses", class: "rounded-md border border-slate-300 px-3 py-2 text-sm", onchange: "this.form.submit()" %>
  <%= select_tag :status, options_for_select(CycleCount.statuses.keys.map { |s| [s.titleize, s] }, params[:status]), include_blank: "All statuses", class: "rounded-md border border-slate-300 px-3 py-2 text-sm", onchange: "this.form.submit()" %>
</form>

<div class="rounded-xl border border-slate-200 bg-white overflow-hidden">
  <table class="w-full border-collapse min-w-[720px]">
    <thead><tr class="bg-slate-50 border-b border-slate-200 text-left text-[11px] uppercase tracking-wide text-slate-500">
      <th class="px-4 py-2.5">WH</th><th class="px-4 py-2.5">Location</th><th class="px-4 py-2.5">Trigger</th><th class="px-4 py-2.5">Status</th>
      <th class="px-4 py-2.5 text-right">Counted</th><th class="px-4 py-2.5 text-right">Variance</th><th></th>
    </tr></thead>
    <tbody>
      <% @counts.each do |c| %>
        <tr class="border-b border-slate-100 hover:bg-slate-50">
          <td class="px-4 py-2 text-xs text-slate-500"><%= c.warehouse.whs_code %></td>
          <td class="px-4 py-2 font-mono text-xs"><%= c.storage_location.loc_code %></td>
          <td class="px-4 py-2 text-xs"><%= c.trigger.titleize %></td>
          <td class="px-4 py-2 text-xs"><%= c.status.titleize %></td>
          <td class="px-4 py-2 text-right text-sm"><%= c.counted_qty&.to_i %></td>
          <td class="px-4 py-2 text-right text-sm <%= c.variance && !c.variance.zero? ? 'text-red-600 font-semibold' : 'text-slate-500' %>"><%= c.variance&.to_i %></td>
          <td class="px-4 py-2 text-right"><%= link_to "View", wms_cycle_count_path(c), class: "text-sm font-semibold text-[#1f4b99] hover:underline" %></td>
        </tr>
      <% end %>
      <% if @counts.empty? %><tr><td colspan="7" class="px-4 py-8 text-center text-sm text-slate-500">No cycle counts.</td></tr><% end %>
    </tbody>
  </table>
</div>
<div class="mt-3"><%= paginate @counts if respond_to?(:paginate) %></div>
