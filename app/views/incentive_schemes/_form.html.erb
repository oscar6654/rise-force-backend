<% examples = {
  "target_multiplier" => %({\n  "base_payout": 500,\n  "tiers": [\n    { "pct": 80,  "payout": 1000 },\n    { "pct": 100, "payout": 2000 },\n    { "pct": 120, "payout": 2000, "multiplier": 1.5 }\n  ]\n}),
  "focus_sku" => %({\n  "it_barcodes": ["4800016641503", "4800016644504"],\n  "rate_per_piece": 0.50\n}),
  "assortment_completion" => %({\n  "assortment_type": "focus",\n  "payout_per_store": 50\n}),
  "coverage" => %({\n  "metric": "productive_call_pct",\n  "threshold": 80,\n  "payout": 1500\n})
} %>

<%= form_with model: scheme, url: (scheme.persisted? ? incentive_scheme_path(scheme) : incentive_schemes_path), method: (scheme.persisted? ? :patch : :post), local: true do |f| %>
  <% if scheme.errors.any? %>
    <div class="rounded-lg bg-red-50 border border-red-200 text-red-700 text-sm px-4 py-3 mb-4"><%= scheme.errors.full_messages.to_sentence %></div>
  <% end %>

  <div class="rounded-xl border border-slate-200 bg-white p-6 mb-5 grid grid-cols-1 md:grid-cols-2 gap-4">
    <div>
      <%= f.label :name, class: "block text-sm font-medium text-slate-700 mb-1" %>
      <%= f.text_field :name, class: "w-full rounded-md border border-slate-300 px-3 py-2 text-sm" %>
    </div>
    <div>
      <%= f.label :scheme_type, "Type", class: "block text-sm font-medium text-slate-700 mb-1" %>
      <%= f.select :scheme_type, IncentiveScheme.scheme_types.keys.map { |t| [t.titleize, t] }, {}, class: "w-full rounded-md border border-slate-300 px-3 py-2 text-sm", data: { controller: "incentive-config" } %>
    </div>
    <div>
      <%= f.label :branch_id, "Branch", class: "block text-sm font-medium text-slate-700 mb-1" %>
      <%= f.collection_select :branch_id, Branch.order(:name), :id, :name, { include_blank: "All branches" }, class: "w-full rounded-md border border-slate-300 px-3 py-2 text-sm" %>
    </div>
    <div>
      <%= f.label :status, class: "block text-sm font-medium text-slate-700 mb-1" %>
      <%= f.select :status, IncentiveScheme.statuses.keys.map { |s| [s.titleize, s] }, {}, class: "w-full rounded-md border border-slate-300 px-3 py-2 text-sm" %>
    </div>
    <div>
      <%= f.label :effective_from, class: "block text-sm font-medium text-slate-700 mb-1" %>
      <%= f.date_field :effective_from, class: "w-full rounded-md border border-slate-300 px-3 py-2 text-sm" %>
    </div>
    <div>
      <%= f.label :effective_to, class: "block text-sm font-medium text-slate-700 mb-1" %>
      <%= f.date_field :effective_to, class: "w-full rounded-md border border-slate-300 px-3 py-2 text-sm" %>
    </div>
  </div>

  <div class="rounded-xl border border-slate-200 bg-white p-6 mb-5">
    <div class="text-sm font-semibold mb-1">Config (JSON)</div>
    <p class="text-xs text-slate-500 mb-3">Rules for this scheme type. Earnings compute on vcsi_rise confirmed sales. Focus-SKU is per <strong>piece</strong>.</p>
    <%= text_area_tag "incentive_scheme[config_json]", (scheme.config.present? ? JSON.pretty_generate(scheme.config) : ""),
          rows: 10, placeholder: examples[scheme.scheme_type] || examples["target_multiplier"],
          class: "w-full rounded-md border border-slate-300 px-3 py-2 text-xs font-mono", spellcheck: false %>
    <div class="mt-3 grid grid-cols-1 md:grid-cols-2 gap-3">
      <% examples.each do |type, ex| %>
        <div class="rounded-lg bg-slate-50 border border-slate-200 p-3">
          <div class="text-[11px] font-semibold text-slate-600 mb-1"><%= type.titleize %> example</div>
          <pre class="text-[10px] text-slate-500 whitespace-pre-wrap font-mono"><%= ex %></pre>
        </div>
      <% end %>
    </div>
  </div>

  <div class="flex items-center gap-2">
    <%= f.submit(scheme.persisted? ? "Save scheme" : "Create scheme", class: "rounded-md bg-[#1f4b99] text-white text-sm font-semibold px-4 py-2 hover:bg-[#17386f] cursor-pointer") %>
    <%= link_to "Cancel", incentive_schemes_path, class: "text-sm text-slate-500 hover:underline px-2" %>
    <% if scheme.persisted? %>
      <%= button_to "Delete", incentive_scheme_path(scheme), method: :delete, class: "ml-auto text-sm text-red-600 hover:underline", form: { data: { turbo_confirm: "Delete this scheme?" } } %>
    <% end %>
  </div>
<% end %>
