<% field_id = "settings_#{setting.key}" %>
<% input_classes = "w-full rounded-md border border-slate-300 px-3 py-2 text-sm" %>
<div class="px-5 py-3.5 grid grid-cols-1 md:grid-cols-3 gap-3 items-start">
  <div class="md:col-span-1">
    <label class="text-sm font-medium text-slate-700" for="<%= field_id %>">
      <%= setting.key.titleize %>
      <% if setting.required? %><span class="text-red-500">*</span><% end %>
      <% if setting.encrypted? %>
        <span class="ml-1 inline-flex items-center px-1.5 py-0.5 rounded text-[10px] font-semibold bg-amber-100 text-amber-800">sensitive</span>
      <% end %>
    </label>
    <% if setting.description.present? %>
      <p class="text-[11px] text-slate-400 mt-0.5"><%= setting.description %></p>
    <% end %>
  </div>
  <div class="md:col-span-2">
    <% if setting.select_options.present? %>
      <select name="settings[<%= setting.key %>]" id="<%= field_id %>" class="<%= input_classes %>">
        <% setting.select_options.each do |val, label| %>
          <option value="<%= val %>" <%= "selected" if setting.value.to_s == val %>><%= label %></option>
        <% end %>
      </select>
    <% elsif setting.value_type == "boolean" %>
      <select name="settings[<%= setting.key %>]" id="<%= field_id %>" class="<%= input_classes %>">
        <option value="true"  <%= "selected" if setting.typed_value %>>Enabled</option>
        <option value="false" <%= "selected" unless setting.typed_value %>>Disabled</option>
      </select>
    <% elsif setting.encrypted? %>
      <div data-controller="password-visibility" class="relative">
        <input data-password-visibility-target="input" type="password"
               name="settings[<%= setting.key %>]" id="<%= field_id %>"
               value="<%= setting.value %>" autocomplete="off" spellcheck="false"
               placeholder="<%= "not set" if setting.value.blank? %>"
               class="<%= input_classes %> font-mono pr-16" />
        <button type="button" data-action="password-visibility#toggle" data-password-visibility-target="label"
                class="absolute inset-y-0 right-0 px-3 text-xs font-semibold text-[#1f4b99] hover:text-[#17386f]">Show</button>
      </div>
      <p class="text-[11px] text-slate-400 mt-1">Saved value is shown masked — clear it to remove, or edit to replace.</p>
    <% elsif setting.value.to_s.length > 60 %>
      <textarea name="settings[<%= setting.key %>]" id="<%= field_id %>" rows="2" class="<%= input_classes %> font-mono"><%= setting.value %></textarea>
    <% else %>
      <input type="text" name="settings[<%= setting.key %>]" id="<%= field_id %>" value="<%= setting.value %>" class="<%= input_classes %> font-mono" />
    <% end %>
  </div>
</div>
