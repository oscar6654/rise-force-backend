<% content_for :page_title, @promo.name %>
<% content_for :page_actions do %>
  <% if can?(:promo, :update) %><%= link_to "Edit", edit_promo_path(@promo), class: "rounded-md bg-[#1f4b99] text-white text-sm font-semibold px-3 py-2 hover:bg-[#17386f]" %><% end %>
<% end %>

<div class="rounded-xl border border-slate-200 bg-white p-6 mx-auto max-w-2xl space-y-2 text-sm mb-4">
  <div><span class="text-slate-500 w-40 inline-block">Code</span><span class="font-mono"><%= @promo.code %></span></div>
  <div><span class="text-slate-500 w-40 inline-block">Mechanic</span><%= @promo.mechanic_type.titleize %></div>
  <div><span class="text-slate-500 w-40 inline-block">Window</span><%= @promo.start_date %> → <%= @promo.end_date %></div>
  <div><span class="text-slate-500 w-40 inline-block">Status</span><%= @promo.status.titleize %></div>
  <div><span class="text-slate-500 w-40 inline-block">Per-store limit</span><%= @promo.unlimited_per_store? ? "Unlimited" : "#{@promo.per_store_limit}× per store" %></div>
  <div><span class="text-slate-500 w-40 inline-block align-top">Eligibility</span>
    <% els = @promo.promo_eligibilities.to_a %>
    <% if els.empty? %><span class="inline-block">All stores</span>
    <% else %>
      <% channels = els.map { |e| e.channel&.name }.compact.uniq %>
      <% scope = [channels.presence&.join(", "), els.first.store_category_ref&.label, els.first.branch&.name].compact %>
      <span class="inline-block"><%= scope.join(" · ").presence || "All stores" %></span>
    <% end %>
  </div>
  <div><span class="text-slate-500 w-40 inline-block">Description</span><%= @promo.description %></div>
</div>

<div class="rounded-xl border border-slate-200 bg-white overflow-hidden">
  <div class="px-4 py-3 border-b border-slate-200 text-sm font-semibold">Mechanic lines</div>
  <table class="w-full border-collapse min-w-[520px]">
    <thead><tr class="bg-slate-50 border-b border-slate-200 text-left text-[11px] uppercase tracking-wide text-slate-500">
      <th class="px-4 py-2.5">Role</th><th class="px-4 py-2.5">Item (IT barcode)</th><th class="px-4 py-2.5">Min qty</th><th class="px-4 py-2.5">Reward</th>
    </tr></thead>
    <tbody>
      <% @lines.each do |l| %>
        <% skus = l.it_barcode.present? ? Product.where(it_barcode: l.it_barcode) : [] %>
        <tr class="border-b border-slate-100">
          <td class="px-4 py-3 text-sm"><%= l.role.titleize %></td>
          <td class="px-4 py-3 text-sm"><%= l.it_barcode.presence || "—" %><% if skus.size > 1 %> <span class="text-xs text-slate-400">(<%= skus.size %> SKUs)</span><% end %></td>
          <td class="px-4 py-3 text-sm"><%= l.min_qty %></td>
          <td class="px-4 py-3 text-sm"><%= l.reward_qty || l.discount_rate || l.discount_amount || l.fixed_price %></td>
        </tr>
      <% end %>
      <% if @lines.empty? %><tr><td colspan="4" class="px-4 py-6 text-center text-sm text-slate-500">No mechanic lines yet.</td></tr><% end %>
    </tbody>
  </table>
</div>

<div class="rounded-xl border border-slate-200 bg-white overflow-hidden mt-4">
  <div class="px-4 py-3 border-b border-slate-200 text-sm font-semibold flex items-center justify-between gap-3">
    <span>Covered SKUs</span>
    <span class="shrink-0 rounded-full bg-slate-100 text-slate-600 text-xs font-semibold px-2.5 py-1"><%= @sku_count %> active SKU<%= "s" unless @sku_count == 1 %></span>
  </div>
  <div class="overflow-x-auto">
    <table class="w-full border-collapse min-w-[520px]">
      <thead><tr class="bg-slate-50 border-b border-slate-200 text-left text-[11px] uppercase tracking-wide text-slate-500">
        <th class="px-4 py-2.5">SKU</th><th class="px-4 py-2.5">Product</th><th class="px-4 py-2.5">Brand</th><th class="px-4 py-2.5">IT barcode</th>
      </tr></thead>
      <tbody>
        <% @skus.each do |p| %>
          <tr class="border-b border-slate-100">
            <td class="px-4 py-3 font-mono text-xs text-slate-600"><%= p.sku %></td>
            <td class="px-4 py-3 text-sm"><%= p.description %></td>
            <td class="px-4 py-3 text-sm text-slate-600"><%= p.brand&.name %></td>
            <td class="px-4 py-3 font-mono text-xs text-slate-500"><%= p.it_barcode %></td>
          </tr>
        <% end %>
        <% if @sku_count.zero? %><tr><td colspan="4" class="px-4 py-6 text-center text-sm text-slate-500">No active SKUs match this promo's barcodes.</td></tr><% end %>
      </tbody>
    </table>
  </div>
  <% if respond_to?(:paginate) && @skus.total_pages > 1 %>
    <div class="px-4 py-3 border-t border-slate-200"><%= paginate @skus %></div>
  <% end %>
</div>
