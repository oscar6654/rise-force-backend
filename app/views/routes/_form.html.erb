<%= form_with model: route, local: true do |f| %>
  <%= render "shared/form_errors", model: route %>
  <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
    <div>
      <%= f.label :code, class: "block text-sm font-medium text-slate-700 mb-1" %>
      <%= f.text_field :code, class: "w-full rounded-md border border-slate-300 px-3 py-2 text-sm" %>
    </div>
    <div>
      <%= f.label :name, class: "block text-sm font-medium text-slate-700 mb-1" %>
      <%= f.text_field :name, class: "w-full rounded-md border border-slate-300 px-3 py-2 text-sm" %>
    </div>
    <% if current_user.all_branches? %>
      <div>
        <%= f.label :branch_id, "Branch", class: "block text-sm font-medium text-slate-700 mb-1" %>
        <%= f.collection_select :branch_id, Branch.order(:name), :id, :name, {}, class: "w-full rounded-md border border-slate-300 px-3 py-2 text-sm" %>
      </div>
    <% end %>
    <div>
      <%= f.label :seller_id, "Seller", class: "block text-sm font-medium text-slate-700 mb-1" %>
      <%= f.collection_select :seller_id, Seller.order(:name), :id, :name, { include_blank: "— unassigned —" }, class: "w-full rounded-md border border-slate-300 px-3 py-2 text-sm", data: { controller: "tom-select" } %>
    </div>
    <div>
      <%= f.label :status, class: "block text-sm font-medium text-slate-700 mb-1" %>
      <%= f.select :status, Route.statuses.keys.map { |s| [s.titleize, s] }, {}, class: "w-full rounded-md border border-slate-300 px-3 py-2 text-sm" %>
    </div>
  </div>
  <div class="mt-5 flex items-center gap-2">
    <%= f.submit(route.persisted? ? "Save changes" : "Create route", class: "rounded-md bg-[#1f4b99] text-white text-sm font-semibold px-4 py-2 hover:bg-[#17386f] cursor-pointer") %>
    <%= link_to "Cancel", routes_path, class: "text-sm text-slate-500 hover:underline px-2" %>
  </div>
<% end %>
