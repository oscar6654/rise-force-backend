<% content_for :page_title, "Manual replenishment" %>
<div class="rounded-xl border border-slate-200 bg-white p-6 max-w-xl">
  <% if @warehouses.empty? %>
    <p class="text-sm text-amber-700">No warehouse has a piece-pick zone set. Set a warehouse's <strong>piece-pick zone</strong> first (on the warehouse master).</p>
  <% else %>
    <%= form_with url: wms_replenishments_path, method: :post, local: true do |f| %>
      <div class="grid grid-cols-1 gap-4">
        <div>
          <label class="block text-sm font-medium text-slate-700 mb-1">Warehouse (with a piece zone)</label>
          <%= select_tag :warehouse_id, options_from_collection_for_select(@warehouses, :id, ->(w) { "#{w.whs_code} (piece zone: #{w.piece_pick_zone})" }), include_blank: "—", class: "w-full rounded-md border border-slate-300 px-3 py-2 text-sm" %>
        </div>
        <div>
          <label class="block text-sm font-medium text-slate-700 mb-1">Product</label>
          <%= select_tag :product_id, options_from_collection_for_select(Product.order(:sku).limit(1000), :id, ->(p) { "#{p.sku} · #{p.description} (#{p.pcs_per_case || 1}/case)" }), include_blank: "—", class: "w-full rounded-md border border-slate-300 px-3 py-2 text-sm", data: { controller: "tom-select" } %>
        </div>
        <div>
          <label class="block text-sm font-medium text-slate-700 mb-1">Cases to break into pieces</label>
          <%= number_field_tag :qty_cases, 1, min: 1, class: "w-full rounded-md border border-slate-300 px-3 py-2 text-sm" %>
          <p class="text-[11px] text-slate-400 mt-1">Picks the oldest full-case stock (FIFO) and drops it into the piece zone as loose pieces. Any loose demand waiting on it is re-allocated.</p>
        </div>
      </div>
      <div class="mt-5">
        <%= submit_tag "Break cases → pieces", class: "rounded-md bg-[#1f4b99] text-white text-sm font-semibold px-4 py-2 hover:bg-[#17386f] cursor-pointer" %>
        <%= link_to "Cancel", wms_replenishments_path, class: "text-sm text-slate-500 hover:underline px-2" %>
      </div>
    <% end %>
  <% end %>
</div>
