<%= form_with model: [:admin, user], local: true do |f| %>
  <% if user.errors.any? %>
    <div class="mb-4 rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800">
      <%= pluralize(user.errors.count, "error") %> prevented saving:
      <ul class="list-disc list-inside mt-1">
        <% user.errors.full_messages.each do |msg| %><li><%= msg %></li><% end %>
      </ul>
    </div>
  <% end %>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
    <div>
      <%= f.label :first_name, class: "block text-sm font-medium text-slate-700 mb-1" %>
      <%= f.text_field :first_name, class: "w-full rounded-md border border-slate-300 px-3 py-2 text-sm" %>
    </div>
    <div>
      <%= f.label :last_name, class: "block text-sm font-medium text-slate-700 mb-1" %>
      <%= f.text_field :last_name, class: "w-full rounded-md border border-slate-300 px-3 py-2 text-sm" %>
    </div>
    <div>
      <%= f.label :email, class: "block text-sm font-medium text-slate-700 mb-1" %>
      <%= f.email_field :email, class: "w-full rounded-md border border-slate-300 px-3 py-2 text-sm" %>
    </div>
    <div>
      <%= f.label :branch_id, "Branch scope", class: "block text-sm font-medium text-slate-700 mb-1" %>
      <%= f.collection_select :branch_id, Branch.order(:name), :id, :name,
            { include_blank: "All branches (global)" },
            class: "w-full rounded-md border border-slate-300 px-3 py-2 text-sm" %>
    </div>
    <div>
      <%= f.label :password, class: "block text-sm font-medium text-slate-700 mb-1" %>
      <%= f.password_field :password, autocomplete: "new-password",
            placeholder: user.persisted? ? "leave blank to keep" : nil,
            class: "w-full rounded-md border border-slate-300 px-3 py-2 text-sm" %>
    </div>
    <div>
      <%= f.label :password_confirmation, class: "block text-sm font-medium text-slate-700 mb-1" %>
      <%= f.password_field :password_confirmation, autocomplete: "new-password",
            class: "w-full rounded-md border border-slate-300 px-3 py-2 text-sm" %>
    </div>
  </div>

  <% unless user.persisted? %>
    <div class="mt-4">
      <label class="block text-sm font-medium text-slate-700 mb-1">Initial role</label>
      <%= select_tag :role, options_from_collection_for_select(Role.active.order(:name), :name, :name, "viewer"),
            class: "w-full md:w-1/2 rounded-md border border-slate-300 px-3 py-2 text-sm" %>
    </div>
  <% end %>

  <div class="mt-5 flex items-center gap-2">
    <%= f.submit(user.persisted? ? "Save changes" : "Create user",
          class: "rounded-md bg-[#1f4b99] text-white text-sm font-semibold px-4 py-2 hover:bg-[#17386f] cursor-pointer") %>
    <%= link_to "Cancel", admin_users_path, class: "text-sm text-slate-500 hover:underline px-2" %>
  </div>
<% end %>
