<% content_for :page_title, "Batch download" %>
<% content_for :page_sub do %>OSB backroom: download orders by branch & seller to cut invoices. Re-downloadable until the batch is invoiced.<% end %>

<div class="rounded-xl border border-slate-200 bg-white overflow-hidden mb-6">
  <div class="px-4 py-3 border-b border-slate-200 text-sm font-semibold">Ready to batch — sellers with unbatched orders</div>
  <table class="w-full border-collapse min-w-[560px]">
    <thead><tr class="bg-slate-50 border-b border-slate-200 text-left text-[11px] uppercase tracking-wide text-slate-500">
      <th class="px-4 py-2.5">Seller</th><th class="px-4 py-2.5 text-right">Unbatched orders</th><th class="px-4 py-2.5 text-right">Value</th><th></th>
    </tr></thead>
    <tbody>
      <% @pending.each do |row| %>
        <% seller = @sellers[row.seller_id] %>
        <tr class="border-b border-slate-100">
          <td class="px-4 py-3 text-sm font-medium"><%= seller&.name %> <span class="text-xs text-slate-400 font-mono"><%= seller&.seller_code %></span></td>
          <td class="px-4 py-3 text-right font-mono text-sm"><%= row.order_count %></td>
          <td class="px-4 py-3 text-right font-mono text-sm"><%= number_with_precision(row.total, precision: 2) %></td>
          <td class="px-4 py-3 text-right">
            <% if can?(:order_batch, :download) %>
              <%= button_to "Build next batch", build_order_batches_path(seller_id: row.seller_id), method: :post,
                    class: "rounded-md bg-[#1f4b99] text-white text-xs font-semibold px-3 py-1.5 hover:bg-[#17386f] cursor-pointer" %>
            <% end %>
          </td>
        </tr>
      <% end %>
      <% if @pending.to_a.empty? %><tr><td colspan="4" class="px-4 py-6 text-center text-sm text-slate-500">No unbatched orders.</td></tr><% end %>
    </tbody>
  </table>
</div>

<div class="rounded-xl border border-slate-200 bg-white overflow-hidden">
  <div class="px-4 py-3 border-b border-slate-200 text-sm font-semibold">Batches</div>
  <%= form_with url: order_batches_path, method: :get, local: true, class: "px-4 py-3 border-b border-slate-200 flex flex-wrap gap-2 items-center" do %>
    <% if @filter_branches && @filter_branches.size > 1 %>
      <%= select_tag :branch_id, options_for_select([["All branches",""]] + @filter_branches.map { |b| [b.name, b.id] }, params[:branch_id]), class: "rounded-md border border-slate-300 px-2 py-2 text-sm" %>
    <% end %>
    <label class="text-xs text-slate-500">From <%= date_field_tag :from, params[:from], class: "rounded-md border border-slate-300 px-2 py-2 text-sm" %></label>
    <label class="text-xs text-slate-500">To <%= date_field_tag :to, params[:to], class: "rounded-md border border-slate-300 px-2 py-2 text-sm" %></label>
    <%= submit_tag "Filter", class: "rounded-md border border-slate-300 text-sm px-3 py-2 hover:bg-slate-50 cursor-pointer" %>
    <span class="text-xs text-slate-500 ml-auto"><%= @batches.total_count %> batches</span>
  <% end %>
  <div class="overflow-x-auto">
    <table class="w-full border-collapse min-w-[820px]">
      <thead><tr class="bg-slate-50 border-b border-slate-200 text-left text-[11px] uppercase tracking-wide text-slate-500">
        <th class="px-4 py-2.5">Batch</th><th class="px-4 py-2.5">Seller</th><th class="px-4 py-2.5 text-right">Orders</th>
        <th class="px-4 py-2.5 text-right">Value</th><th class="px-4 py-2.5">Status</th><th class="px-4 py-2.5">Downloaded</th><th></th>
      </tr></thead>
      <tbody>
        <% @batches.each do |b| %>
          <tr class="border-b border-slate-100 hover:bg-slate-50">
            <td class="px-4 py-3 font-mono text-xs whitespace-nowrap"><%= b.batch_number %></td>
            <td class="px-4 py-3 text-sm text-slate-600"><%= b.seller&.name %></td>
            <td class="px-4 py-3 text-right font-mono text-sm"><%= b.order_count %></td>
            <td class="px-4 py-3 text-right font-mono text-sm"><%= number_with_precision(b.total_amount, precision: 2) %></td>
            <td class="px-4 py-3"><span class="rounded-full text-[11px] font-semibold px-2 py-0.5 <%= b.downloaded? || b.invoiced? ? 'bg-emerald-100 text-emerald-700' : 'bg-amber-100 text-amber-700' %>"><%= b.status.titleize %></span></td>
            <td class="px-4 py-3 text-xs text-slate-500"><%= b.downloaded_at ? "#{b.downloaded_at.strftime('%d %b %H:%M')} · #{b.downloaded_by&.full_name}" : "—" %></td>
            <td class="px-4 py-3 text-right"><%= link_to "Open", order_batch_path(b), class: "text-sm font-semibold text-[#1f4b99] hover:underline" %></td>
          </tr>
        <% end %>
        <% if @batches.empty? %><tr><td colspan="7" class="px-4 py-8 text-center text-sm text-slate-500">No batches yet.</td></tr><% end %>
      </tbody>
    </table>
  </div>
  <div class="px-4 py-3"><%= paginate @batches if respond_to?(:paginate) %></div>
</div>
