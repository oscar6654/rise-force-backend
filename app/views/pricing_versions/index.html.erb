<% content_for :page_title, "Pricing master" %>
<% content_for :page_sub do %>Markup matrix: store category × product tier. Store price = base × (1 + markup)<% end %>
<% content_for :page_actions do %>
  <% if can?(:pricing, :create) %>
    <%= link_to "New version", new_pricing_version_path, class: "rounded-md bg-[#1f4b99] text-white text-sm font-semibold px-3 py-2 hover:bg-[#17386f]" %>
  <% end %>
<% end %>

<% if @current %>
  <div class="rounded-xl border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm text-emerald-800 mb-4">
    Current published matrix: <strong>v<%= @current.version_number %></strong> — effective <%= @current.effective_date.strftime("%d %b %Y") %>.
    Changes apply at the next seller sync.
  </div>
<% else %>
  <div class="rounded-xl border border-amber-200 bg-amber-50 px-4 py-3 text-sm text-amber-800 mb-4">No published pricing version yet.</div>
<% end %>

<div class="rounded-xl border border-slate-200 bg-white overflow-hidden">
  <table class="w-full border-collapse min-w-[560px]">
    <thead><tr class="bg-slate-50 border-b border-slate-200 text-left text-[11px] uppercase tracking-wide text-slate-500">
      <th class="px-4 py-2.5">Version</th><th class="px-4 py-2.5">Effective</th><th class="px-4 py-2.5">Status</th><th></th>
    </tr></thead>
    <tbody>
      <% @versions.each do |v| %>
        <tr class="border-b border-slate-100 hover:bg-slate-50">
          <td class="px-4 py-3 text-sm font-medium">v<%= v.version_number %> <span class="text-slate-500 font-normal"><%= v.name %></span></td>
          <td class="px-4 py-3 text-sm text-slate-600"><%= v.effective_date.strftime("%d %b %Y") %></td>
          <td class="px-4 py-3"><span class="rounded-full text-[11px] font-semibold px-2 py-0.5 <%= v.published? ? 'bg-emerald-100 text-emerald-700' : v.draft? ? 'bg-amber-100 text-amber-700' : 'bg-slate-100 text-slate-600' %>"><%= v.status.titleize %></span></td>
          <td class="px-4 py-3 text-right">
            <%= link_to "View", pricing_version_path(v), class: "text-sm font-semibold text-[#1f4b99] hover:underline mr-3" %>
            <% if v.draft? && can?(:pricing, :update) %><%= link_to "Edit", edit_pricing_version_path(v), class: "text-sm font-semibold text-[#1f4b99] hover:underline" %><% end %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
