<% content_for :page_title, "Incentive schemes" %>
<% content_for :page_sub do %>How sellers earn — computed on vcsi_rise confirmed sales<% end %>
<% content_for :page_actions do %>
  <% if can?(:incentive_scheme, :create) %>
    <%= link_to "New scheme", new_incentive_scheme_path, class: "rounded-md bg-[#1f4b99] text-white text-sm font-semibold px-3 py-2 hover:bg-[#17386f]" %>
  <% end %>
<% end %>

<div class="rounded-xl border border-slate-200 bg-white overflow-hidden">
  <div class="overflow-x-auto">
    <table class="w-full border-collapse min-w-[820px]">
      <thead><tr class="bg-slate-50 border-b border-slate-200 text-left text-[11px] uppercase tracking-wide text-slate-500">
        <th class="px-4 py-2.5">Scheme</th><th class="px-4 py-2.5">Type</th><th class="px-4 py-2.5">Branch</th>
        <th class="px-4 py-2.5">Window</th><th class="px-4 py-2.5">Status</th><th></th>
      </tr></thead>
      <tbody class="text-sm">
        <% @schemes.each do |s| %>
          <tr class="border-b border-slate-100 hover:bg-slate-50">
            <td class="px-4 py-3 font-medium"><%= s.name %></td>
            <td class="px-4 py-3"><span class="rounded bg-slate-100 text-slate-700 text-[11px] font-semibold px-2 py-0.5"><%= s.scheme_type.titleize %></span></td>
            <td class="px-4 py-3 text-slate-600"><%= s.branch&.name || "All branches" %></td>
            <td class="px-4 py-3 text-slate-600 text-xs"><%= s.effective_from || "—" %> → <%= s.effective_to || "open" %></td>
            <td class="px-4 py-3"><span class="rounded-full text-[11px] font-semibold px-2 py-0.5 <%= s.active? ? 'bg-emerald-100 text-emerald-700' : 'bg-slate-100 text-slate-600' %>"><%= s.status.titleize %></span></td>
            <td class="px-4 py-3 text-right whitespace-nowrap">
              <% if can?(:incentive_scheme, :update) %><%= link_to "Edit", edit_incentive_scheme_path(s), class: "text-sm font-semibold text-[#1f4b99] hover:underline" %><% end %>
            </td>
          </tr>
        <% end %>
        <% if @schemes.empty? %>
          <tr><td colspan="6" class="px-4 py-8 text-center text-slate-500 text-sm">No incentive schemes yet — create one to reward sellers.</td></tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
