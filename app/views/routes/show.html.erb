<% content_for :page_title, @route.display_name %>
<% content_for :page_sub do %>F2 = twice/month (weeks 1+3 or 2+4) · F4 = weekly · fixed visit day Mon–Sat<% end %>
<% content_for :page_actions do %>
  <% if can?(:route_plan, :update) %><%= link_to "Edit route", edit_route_path(@route), class: "rounded-md border border-slate-300 bg-white text-slate-700 text-sm font-semibold px-3 py-2 hover:bg-slate-50" %><% end %>
<% end %>

<%# ---- Coverage calendar preview ---- %>
<div class="rounded-xl border border-slate-200 bg-white p-5 mb-4">
  <div class="text-sm font-semibold mb-3">Coverage preview — stores scheduled per day</div>
  <div class="overflow-x-auto">
    <table class="border-collapse">
      <thead><tr>
        <th class="px-2 py-1 text-[10px] uppercase text-slate-400"></th>
        <% %w[Mon Tue Wed Thu Fri Sat].each do |d| %><th class="px-3 py-1 text-[10px] uppercase text-slate-400 text-center"><%= d %></th><% end %>
      </tr></thead>
      <tbody>
        <% @calendar.each_with_index do |week, i| %>
          <tr>
            <td class="px-2 py-1 text-[11px] font-mono font-semibold text-slate-500">W<%= i + 1 %></td>
            <% week.each do |count| %>
              <td class="px-1.5 py-1.5">
                <div class="w-9 h-9 grid place-items-center rounded text-xs font-semibold <%= count.zero? ? 'bg-slate-50 text-slate-300' : 'bg-blue-50 text-[#1f4b99]' %>"><%= count.zero? ? '·' : count %></div>
              </td>
            <% end %>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>

<%# ---- Per-store frequency editor ---- %>
<%= form_with url: update_frequencies_route_path(@route), method: :patch, local: true do %>
  <div class="rounded-xl border border-slate-200 bg-white overflow-hidden">
    <div class="px-4 py-3 border-b border-slate-200 flex items-center gap-2">
      <div class="flex-1 text-sm font-semibold">Per-store frequency · <%= @route.seller&.name || "unassigned" %></div>
      <% if can?(:route_plan, :update) %>
        <%= submit_tag "Save changes", class: "rounded-md bg-[#1f4b99] text-white text-sm font-semibold px-3 py-2 hover:bg-[#17386f] cursor-pointer" %>
      <% end %>
    </div>
    <div class="overflow-x-auto">
      <table class="w-full border-collapse min-w-[820px]">
        <thead><tr class="bg-slate-50 border-b border-slate-200 text-left text-[11px] uppercase tracking-wide text-slate-500">
          <th class="px-4 py-2.5">Store</th><th class="px-4 py-2.5">Frequency</th><th class="px-4 py-2.5">Week pattern</th><th class="px-4 py-2.5">Visit day</th><th class="px-4 py-2.5">Seq</th>
        </tr></thead>
        <tbody>
          <% disabled = cannot?(:route_plan, :update) %>
          <% @stores.each do |s| %>
            <tr class="border-b border-slate-100">
              <td class="px-4 py-2.5"><div class="text-sm font-medium"><%= s.name %></div><div class="text-xs font-mono text-slate-500"><%= s.code %></div></td>
              <td class="px-4 py-2.5"><%= select_tag "stores[#{s.id}][visit_frequency]", options_for_select([["F2","f2"],["F4","f4"]], s.visit_frequency), disabled: disabled, class: "rounded border border-slate-300 text-sm px-2 py-1" %></td>
              <td class="px-4 py-2.5"><%= select_tag "stores[#{s.id}][week_pattern]", options_for_select([["Every week","every_week"],["Weeks 1&3","weeks_1_3"],["Weeks 2&4","weeks_2_4"]], s.week_pattern), disabled: disabled, class: "rounded border border-slate-300 text-sm px-2 py-1" %></td>
              <td class="px-4 py-2.5"><%= select_tag "stores[#{s.id}][visit_day]", options_for_select(Store.visit_days.keys.map { |d| [d.titleize, d] }, s.visit_day), include_blank: "—", disabled: disabled, class: "rounded border border-slate-300 text-sm px-2 py-1" %></td>
              <td class="px-4 py-2.5"><%= number_field_tag "stores[#{s.id}][visit_sequence]", s.visit_sequence, disabled: disabled, class: "w-16 rounded border border-slate-300 text-sm px-2 py-1" %></td>
            </tr>
          <% end %>
          <% if @stores.empty? %><tr><td colspan="5" class="px-4 py-8 text-center text-sm text-slate-500">No stores on this route yet.</td></tr><% end %>
        </tbody>
      </table>
    </div>
  </div>
<% end %>
<p class="mt-3"><%= link_to "← All routes", routes_path, class: "text-sm text-[#1f4b99] hover:underline" %></p>
