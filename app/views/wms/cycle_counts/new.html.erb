<% content_for :page_title, "Open a cycle count" %>
<div class="rounded-xl border border-slate-200 bg-white p-6 max-w-xl">
  <%= form_with url: wms_cycle_counts_path, method: :post, local: true do |f| %>
    <div class="mb-4">
      <label class="block text-sm font-medium text-slate-700 mb-1">Location</label>
      <%= select_tag :storage_location_id, options_from_collection_for_select(@locations, :id, ->(l) { "#{l.warehouse.whs_code} · #{l.loc_code}#{' ⚑' if l.needs_cycle_count}" }), include_blank: "—", class: "w-full rounded-md border border-slate-300 px-3 py-2 text-sm", data: { controller: "tom-select" } %>
      <p class="mt-1 text-xs text-slate-500">The system qty is snapshotted now and hidden from the counter (blind count).</p>
    </div>
    <%= submit_tag "Open count", class: "rounded-md bg-[#1f4b99] text-white text-sm font-semibold px-4 py-2 hover:bg-[#17386f] cursor-pointer" %>
    <%= link_to "Cancel", wms_cycle_counts_path, class: "text-sm text-slate-500 hover:underline px-2" %>
  <% end %>
</div>
