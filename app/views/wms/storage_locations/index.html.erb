<% content_for :page_title, "Storage locations" %>
<% content_for :page_actions do %>
  <%= link_to "Upload CSV", new_import_path("storage_locations"), class: "rounded-md border border-slate-300 text-sm font-semibold px-3 py-2 hover:bg-slate-50" if can?(:storage_location, :create) %>
  <%= link_to "Download CSV", export_path("storage_locations"), class: "rounded-md border border-slate-300 text-sm font-semibold px-3 py-2 hover:bg-slate-50" if can?(:storage_location, :download) %>
  <%= link_to "New location", new_wms_storage_location_path, class: "rounded-md bg-[#1f4b99] text-white text-sm font-semibold px-3 py-2 hover:bg-[#17386f]" if can?(:storage_location, :create) %>
<% end %>

<form class="mb-3 flex gap-2" method="get">
  <%= select_tag :warehouse_id, options_from_collection_for_select(@warehouses, :id, :whs_code, params[:warehouse_id]), include_blank: "All warehouses", class: "rounded-md border border-slate-300 px-3 py-2 text-sm", onchange: "this.form.submit()" %>
</form>

<div class="rounded-xl border border-slate-200 bg-white overflow-hidden">
  <table class="w-full border-collapse min-w-[760px]">
    <thead><tr class="bg-slate-50 border-b border-slate-200 text-left text-[11px] uppercase tracking-wide text-slate-500">
      <th class="px-3 py-2.5">Warehouse</th><th class="px-3 py-2.5">Code</th><th class="px-3 py-2.5">Zone</th><th class="px-3 py-2.5">Type</th>
      <th class="px-3 py-2.5">Pickable</th><th class="px-3 py-2.5">Cap</th><th class="px-3 py-2.5">Seq</th><th class="px-3 py-2.5">Accepts</th><th></th>
    </tr></thead>
    <tbody>
      <% @locations.each do |l| %>
        <tr class="border-b border-slate-100 hover:bg-slate-50 <%= 'bg-amber-50' if l.needs_cycle_count %>">
          <td class="px-3 py-2 text-xs text-slate-500"><%= l.warehouse.whs_code %></td>
          <td class="px-3 py-2 font-mono text-xs"><%= l.loc_code %><% if l.needs_cycle_count %> <span class="text-amber-600" title="flagged for cycle count">⚑</span><% end %></td>
          <td class="px-3 py-2 text-sm"><%= l.zone %></td>
          <td class="px-3 py-2 text-xs"><%= l.loc_type.titleize %></td>
          <td class="px-3 py-2 text-xs"><%= l.pickable ? "✓" : "—" %></td>
          <td class="px-3 py-2 text-xs"><%= l.slot_capacity %></td>
          <td class="px-3 py-2 text-xs"><%= l.pick_sequence %></td>
          <td class="px-3 py-2 text-xs text-slate-500"><%= Array(l.allowed_abc_classes).join(",").presence || "any" %></td>
          <td class="px-3 py-2 text-right"><%= link_to "Edit", edit_wms_storage_location_path(l), class: "text-sm font-semibold text-[#1f4b99] hover:underline" if can?(:storage_location, :update) %></td>
        </tr>
      <% end %>
      <% if @locations.empty? %><tr><td colspan="9" class="px-4 py-8 text-center text-sm text-slate-500">No storage locations yet. Upload a CSV to get started.</td></tr><% end %>
    </tbody>
  </table>
</div>
<div class="mt-3"><%= paginate @locations if respond_to?(:paginate) %></div>
