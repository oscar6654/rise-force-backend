<% content_for :page_title, "Replenishment" %>
<% content_for :page_actions do %>
  <%= link_to "Manual drop (cases → pieces)", new_wms_replenishment_path, class: "rounded-md bg-[#1f4b99] text-white text-sm font-semibold px-3 py-2 hover:bg-[#17386f]" if can?(:replenishment, :create) %>
<% end %>

<form class="mb-3 flex gap-2" method="get">
  <%= select_tag :warehouse_id, options_from_collection_for_select(@warehouses, :id, :whs_code, params[:warehouse_id]), include_blank: "All WMS warehouses", class: "rounded-md border border-slate-300 px-3 py-2 text-sm", onchange: "this.form.submit()" %>
  <%= select_tag :status, options_for_select(ReplenishmentTask.statuses.keys.map { |s| [s.titleize, s] }, params[:status]), include_blank: "All statuses", class: "rounded-md border border-slate-300 px-3 py-2 text-sm", onchange: "this.form.submit()" %>
</form>

<div class="rounded-xl border border-slate-200 bg-white overflow-hidden">
  <table class="w-full border-collapse min-w-[760px]">
    <thead><tr class="bg-slate-50 border-b border-slate-200 text-left text-[11px] uppercase tracking-wide text-slate-500">
      <th class="px-4 py-2.5">WH</th><th class="px-4 py-2.5">SKU</th><th class="px-4 py-2.5 text-right">Cases</th><th class="px-4 py-2.5 text-right">Pieces</th>
      <th class="px-4 py-2.5">→ Piece loc</th><th class="px-4 py-2.5">Trigger</th><th class="px-4 py-2.5">Status</th><th></th>
    </tr></thead>
    <tbody>
      <% @tasks.each do |t| %>
        <tr class="border-b border-slate-100 hover:bg-slate-50">
          <td class="px-4 py-2 text-xs text-slate-500"><%= t.warehouse.whs_code %></td>
          <td class="px-4 py-2 font-mono text-xs"><%= t.product.sku %></td>
          <td class="px-4 py-2 text-right text-sm font-semibold"><%= t.qty_cases %></td>
          <td class="px-4 py-2 text-right text-xs text-slate-500"><%= t.pieces.to_i %></td>
          <td class="px-4 py-2 font-mono text-xs"><%= t.piece_location&.loc_code || "—" %></td>
          <td class="px-4 py-2 text-xs"><%= t.trigger.titleize %></td>
          <td class="px-4 py-2 text-xs"><%= t.status.titleize %></td>
          <td class="px-4 py-2 text-right whitespace-nowrap">
            <% if t.pending? || t.assigned? %>
              <%= button_to "Execute", execute_wms_replenishment_path(t), class: "rounded-md bg-emerald-600 text-white text-xs font-semibold px-3 py-1.5 hover:bg-emerald-700 inline-block" if can?(:replenishment, :create) %>
              <%= button_to "Cancel", cancel_wms_replenishment_path(t), class: "text-xs text-slate-500 hover:underline px-2 inline-block" if can?(:replenishment, :update) %>
            <% end %>
          </td>
        </tr>
      <% end %>
      <% if @tasks.empty? %><tr><td colspan="8" class="px-4 py-8 text-center text-sm text-slate-500">No replenishment tasks.</td></tr><% end %>
    </tbody>
  </table>
</div>
<div class="mt-3"><%= paginate @tasks if respond_to?(:paginate) %></div>
