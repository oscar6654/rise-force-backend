<% content_for :page_title, "Display targets" %>

<div class="flex items-center justify-between mb-4">
  <p class="text-sm text-slate-600 max-w-2xl">Upload a display/visibility <strong>target</strong> xlsx (the base plan) with a date window, then upload the <strong>execution CSV</strong> (photos) inside it. The app shows sellers &amp; managers which stores hit or missed their targets.</p>
  <% if can?(:display_campaign, :create) %>
    <%= link_to "+ New campaign", new_display_campaign_path, class: "shrink-0 rounded-md bg-[#1f4b99] text-white text-sm font-semibold px-4 py-2 hover:bg-[#17386f]" %>
  <% end %>
</div>

<div class="rounded-xl border border-slate-200 bg-white overflow-hidden">
  <table class="w-full text-sm">
    <thead class="bg-slate-50 text-slate-500 text-left text-xs uppercase tracking-wide">
      <tr>
        <th class="px-4 py-2.5">Campaign</th>
        <th class="px-4 py-2.5">Window</th>
        <th class="px-4 py-2.5 text-right">Targets</th>
        <th class="px-4 py-2.5 text-right">Evidence</th>
        <th class="px-4 py-2.5">Status</th>
        <th class="px-4 py-2.5"></th>
      </tr>
    </thead>
    <tbody class="divide-y divide-slate-100">
      <% @campaigns.each do |c| %>
        <tr class="hover:bg-slate-50">
          <td class="px-4 py-2.5">
            <%= link_to c.name, display_campaign_path(c), class: "font-semibold text-[#1f4b99] hover:underline" %>
            <div class="text-xs text-slate-400"><%= c.source_filename %></div>
          </td>
          <td class="px-4 py-2.5 text-slate-600"><%= c.period_from.strftime("%b %-d") %> – <%= c.period_to.strftime("%b %-d, %Y") %></td>
          <td class="px-4 py-2.5 text-right tabular-nums"><%= c.display_targets.count %></td>
          <td class="px-4 py-2.5 text-right tabular-nums"><%= c.display_evidences.count %></td>
          <td class="px-4 py-2.5">
            <% if c.active? && c.period_from <= Date.current && c.period_to >= Date.current %>
              <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[11px] font-semibold bg-green-100 text-green-800">Live</span>
            <% else %>
              <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[11px] font-semibold bg-slate-100 text-slate-500">Off-window</span>
            <% end %>
          </td>
          <td class="px-4 py-2.5 text-right">
            <% if can?(:display_campaign, :destroy) %>
              <%= button_to "Delete", display_campaign_path(c), method: :delete, form: { data: { turbo_confirm: "Delete this campaign and all its data?" } }, class: "text-xs text-red-600 hover:underline" %>
            <% end %>
          </td>
        </tr>
      <% end %>
      <% if @campaigns.empty? %>
        <tr><td colspan="6" class="px-4 py-8 text-center text-slate-400">No campaigns yet.</td></tr>
      <% end %>
    </tbody>
  </table>
</div>
