<% content_for :page_title, "New pricing version" %>
<div class="rounded-xl border border-slate-200 bg-white p-6 mx-auto max-w-xl">
  <%= form_with model: @version, local: true do |f| %>
    <%= render "shared/form_errors", model: @version %>
    <p class="text-sm text-slate-500 mb-4">A new draft is seeded from the current published matrix. Set markups next, then publish.</p>
    <div class="space-y-4">
      <div>
        <%= f.label :name, class: "block text-sm font-medium text-slate-700 mb-1" %>
        <%= f.text_field :name, class: "w-full rounded-md border border-slate-300 px-3 py-2 text-sm" %>
      </div>
      <div>
        <%= f.label :effective_date, class: "block text-sm font-medium text-slate-700 mb-1" %>
        <%= f.date_field :effective_date, class: "w-full rounded-md border border-slate-300 px-3 py-2 text-sm" %>
      </div>
      <div>
        <%= f.label :notes, class: "block text-sm font-medium text-slate-700 mb-1" %>
        <%= f.text_area :notes, rows: 2, class: "w-full rounded-md border border-slate-300 px-3 py-2 text-sm" %>
      </div>
    </div>
    <div class="mt-5 flex items-center gap-2">
      <%= f.submit "Create draft", class: "rounded-md bg-[#1f4b99] text-white text-sm font-semibold px-4 py-2 hover:bg-[#17386f] cursor-pointer" %>
      <%= link_to "Cancel", pricing_versions_path, class: "text-sm text-slate-500 hover:underline px-2" %>
    </div>
  <% end %>
</div>
