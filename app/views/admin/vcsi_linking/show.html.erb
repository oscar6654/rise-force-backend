<% content_for :page_title, "vcsi_rise linking" %>
<% content_for :page_sub do %>What to link, and a health check so bad links don't cause silent sync gaps<% end %>

<%# ---- Config status ---- %>
<div class="rounded-xl border <%= @configured ? 'border-emerald-200 bg-emerald-50' : 'border-amber-200 bg-amber-50' %> px-4 py-3 text-sm mb-5 flex items-center gap-3">
  <span><%= @configured ? "✓" : "⚠" %></span>
  <div class="flex-1">
    <% if @configured %>
      vcsi_rise API is configured. Set the manual <strong>McpAccessToken</strong> (from vcsi_rise) as the API token in
      <%= link_to "System settings → vcsi", admin_system_settings_path(tab: "vcsi"), class: "text-[#1f4b99] hover:underline" %>.
    <% else %>
      Not configured yet. Add <strong>vcsi_rise_base_url</strong> and <strong>vcsi_rise_api_token</strong> in
      <%= link_to "System settings → vcsi", admin_system_settings_path(tab: "vcsi"), class: "text-[#1f4b99] hover:underline" %>
      (the token is a manual McpAccessToken minted in vcsi_rise for a service user with company-wide sales access).
    <% end %>
  </div>
</div>

<%# ---- What to link ---- %>
<div class="rounded-xl border border-slate-200 bg-white overflow-hidden mb-5">
  <div class="px-4 py-3 border-b border-slate-200 text-sm font-semibold">What to link — and the join key</div>
  <div class="overflow-x-auto">
    <table class="w-full border-collapse min-w-[720px]">
      <thead><tr class="bg-slate-50 border-b border-slate-200 text-left text-[11px] uppercase tracking-wide text-slate-500">
        <th class="px-4 py-2.5">SFA record</th><th class="px-4 py-2.5">Field to set</th><th class="px-4 py-2.5">Maps to vcsi_rise</th><th class="px-4 py-2.5">Used for</th>
      </tr></thead>
      <tbody class="text-sm">
        <tr class="border-b border-slate-100"><td class="px-4 py-2.5 font-medium">Seller</td><td class="px-4 py-2.5 font-mono text-xs">vcsi_sales_rep_ref</td><td class="px-4 py-2.5"><code>seller_masters.sales_rep</code></td><td class="px-4 py-2.5 text-slate-600">Targets + actual sellout</td></tr>
        <tr class="border-b border-slate-100"><td class="px-4 py-2.5 font-medium">Store</td><td class="px-4 py-2.5 font-mono text-xs">vcsi_customer_ref</td><td class="px-4 py-2.5"><code>customer_masters.customer_id</code></td><td class="px-4 py-2.5 text-slate-600">Store-level sellout / stock</td></tr>
        <tr class="border-b border-slate-100"><td class="px-4 py-2.5 font-medium">Product</td><td class="px-4 py-2.5 font-mono text-xs">vcsi_product_ref / it_barcode</td><td class="px-4 py-2.5"><code>product_masters.itemkey</code> / barcode</td><td class="px-4 py-2.5 text-slate-600">Per-SKU sellout</td></tr>
        <tr><td class="px-4 py-2.5 font-medium">Branch</td><td class="px-4 py-2.5 font-mono text-xs">vcsi_branch_ref</td><td class="px-4 py-2.5"><code>branch_code</code></td><td class="px-4 py-2.5 text-slate-600">Branch rollups</td></tr>
      </tbody>
    </table>
  </div>
  <p class="px-4 py-3 text-xs text-slate-500 border-t border-slate-100 space-y-1">
    <span class="block"><strong>Seller</strong> links pull the <em>target</em> (from vcsi_rise) and actual sellout, keyed on <code>sales_rep</code>.</span>
    <span class="block"><strong>Store</strong> links pull actual sellout keyed on <code>customer_id</code>. vcsi_rise carries store <em>history</em> but no store target, so SFA <strong>derives</strong> each store's target from its trailing sales history (3-month average + growth uplift, configurable in <%= link_to "System settings → vcsi", admin_system_settings_path(tab: "vcsi"), class: "text-[#1f4b99] hover:underline" %>).</span>
    <span class="block">Set the refs, then run the syncs from <%= link_to "Import logs", job_logs_path, class: "text-[#1f4b99] hover:underline" %> (Targets · Sellout · Store sellout · Store targets).</span>
  </p>
</div>

<%# ---- Link coverage ---- %>
<div class="grid grid-cols-2 lg:grid-cols-4 gap-4 mb-5">
  <% @coverage.each do |entity, s| %>
    <div class="rounded-xl border border-slate-200 bg-white p-4">
      <div class="text-[11px] uppercase tracking-wide text-slate-500 font-semibold"><%= entity.to_s.titleize %> links</div>
      <div class="text-2xl font-semibold mt-1"><%= s[:linked] %><span class="text-slate-400 text-lg">/<%= s[:total] %></span></div>
      <% if s[:unlinked].positive? %>
        <div class="text-xs text-amber-600 mt-1"><%= s[:unlinked] %> unlinked</div>
      <% else %>
        <div class="text-xs text-emerald-600 mt-1">all linked</div>
      <% end %>
    </div>
  <% end %>
</div>

<%# ---- Live validation ---- %>
<div class="rounded-xl border border-slate-200 bg-white overflow-hidden mb-5">
  <div class="px-4 py-3 border-b border-slate-200 flex items-center gap-2">
    <div class="flex-1 text-sm font-semibold">Validate links against vcsi_rise</div>
    <% if @configured %>
      <%= link_to "Run validation", admin_vcsi_linking_path(validate: 1), class: "rounded-md border border-slate-300 text-sm font-semibold px-3 py-1.5 hover:bg-slate-50" %>
    <% end %>
  </div>

  <% if @validation_error %>
    <div class="px-4 py-3 text-sm text-red-700">Could not reach vcsi_rise: <%= @validation_error %></div>
  <% elsif @validation_ran %>
    <div class="p-4 grid grid-cols-1 md:grid-cols-3 gap-4 text-sm">
      <div class="rounded-lg bg-emerald-50 border border-emerald-200 p-3">
        <div class="font-semibold text-emerald-800"><%= @valid_links.size %> valid</div>
        <div class="text-xs text-emerald-700 mt-1">Local sellers whose ref exists in vcsi_rise.</div>
      </div>
      <div class="rounded-lg bg-red-50 border border-red-200 p-3">
        <div class="font-semibold text-red-800"><%= @invalid_links.size %> invalid</div>
        <div class="text-xs text-red-700 mt-1">Ref set but NOT found in vcsi_rise — fix these (typo / stale code).</div>
      </div>
      <div class="rounded-lg bg-slate-50 border border-slate-200 p-3">
        <div class="font-semibold text-slate-700"><%= @unmatched_remote.size %> not yet linked</div>
        <div class="text-xs text-slate-500 mt-1">vcsi_rise sellers with no matching local seller.</div>
      </div>
    </div>
    <% if @invalid_links.any? %>
      <div class="px-4 pb-4">
        <div class="text-xs font-semibold text-red-700 mb-1">Invalid seller links (bug risk):</div>
        <div class="flex flex-wrap gap-2">
          <% @invalid_links.each do |s| %>
            <% if can?(:seller, :update) %>
              <%= link_to edit_seller_path(s), class: "rounded bg-red-50 border border-red-200 text-red-700 text-xs px-2 py-1 hover:bg-red-100" do %>
                <%= s.name %> · <span class="font-mono"><%= s.vcsi_sales_rep_ref %></span>
              <% end %>
            <% else %>
              <span class="rounded bg-red-50 border border-red-200 text-red-700 text-xs px-2 py-1"><%= s.name %> · <span class="font-mono"><%= s.vcsi_sales_rep_ref %></span></span>
            <% end %>
          <% end %>
        </div>
      </div>
    <% end %>

    <%# ---- Store link validation (checks only the refs that are set) ---- %>
    <div class="px-4 pb-4 border-t border-slate-100 pt-4">
      <div class="text-xs font-semibold text-slate-600 mb-2">Store links (of <%= @store_valid.size + @store_invalid.size %> linked stores)</div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-sm">
        <div class="rounded-lg bg-emerald-50 border border-emerald-200 p-3">
          <div class="font-semibold text-emerald-800"><%= @store_valid.size %> valid</div>
          <div class="text-xs text-emerald-700 mt-1">vcsi_customer_ref found in the vcsi_rise customer master.</div>
        </div>
        <div class="rounded-lg bg-red-50 border border-red-200 p-3">
          <div class="font-semibold text-red-800"><%= @store_invalid.size %> invalid</div>
          <div class="text-xs text-red-700 mt-1">Ref set but NOT a real customer_id — fix these.</div>
        </div>
      </div>
      <% if @store_invalid.any? %>
        <div class="mt-3">
          <div class="text-xs font-semibold text-red-700 mb-1">Invalid store links:</div>
          <div class="flex flex-wrap gap-2">
            <% @store_invalid.each do |s| %>
              <% if can?(:store, :update) %>
                <%= link_to edit_store_path(s), class: "rounded bg-red-50 border border-red-200 text-red-700 text-xs px-2 py-1 hover:bg-red-100" do %>
                  <%= s.name %> · <span class="font-mono"><%= s.vcsi_customer_ref %></span>
                <% end %>
              <% else %>
                <span class="rounded bg-red-50 border border-red-200 text-red-700 text-xs px-2 py-1"><%= s.name %> · <span class="font-mono"><%= s.vcsi_customer_ref %></span></span>
              <% end %>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  <% else %>
    <div class="px-4 py-3 text-xs text-slate-500">Run validation to see which links are valid, invalid, or not yet linked.</div>
  <% end %>
</div>

<%# ---- Unlinked sellers to fix ---- %>
<% if @unlinked_sellers.any? %>
  <div class="rounded-xl border border-slate-200 bg-white overflow-hidden">
    <div class="px-4 py-3 border-b border-slate-200 text-sm font-semibold">Sellers missing a vcsi_rise code (<%= @unlinked_sellers.size %>)</div>
    <div class="p-4 flex flex-wrap gap-2">
      <% @unlinked_sellers.each do |s| %>
        <% if can?(:seller, :update) %>
          <%= link_to s.name, edit_seller_path(s), class: "rounded bg-amber-50 border border-amber-200 text-amber-700 text-xs px-2 py-1 hover:bg-amber-100" %>
        <% else %>
          <span class="rounded bg-amber-50 border border-amber-200 text-amber-700 text-xs px-2 py-1"><%= s.name %></span>
        <% end %>
      <% end %>
    </div>
  </div>
<% end %>
