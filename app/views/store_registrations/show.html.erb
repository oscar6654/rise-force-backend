<% content_for :page_title, "Review — #{@registration.name}" %>

<div class="grid grid-cols-1 lg:grid-cols-2 gap-4">
  <div class="rounded-xl border border-slate-200 bg-white p-6 space-y-2 text-sm">
    <h2 class="text-sm font-semibold mb-2">Submitted details</h2>
    <div><span class="text-slate-500 w-32 inline-block">Name</span><%= @registration.name %></div>
    <div><span class="text-slate-500 w-32 inline-block">Owner</span><%= @registration.owner_name %></div>
    <div><span class="text-slate-500 w-32 inline-block">Contact</span><%= @registration.contact_number %></div>
    <div><span class="text-slate-500 w-32 inline-block">Address</span><%= @registration.address %></div>
    <div><span class="text-slate-500 w-32 inline-block">GPS</span><%= @registration.latitude %>, <%= @registration.longitude %></div>
    <div><span class="text-slate-500 w-32 inline-block">Channel</span><%= @registration.channel&.name || "—" %> <span class="text-xs text-slate-400">(seller-picked)</span></div>
    <div><span class="text-slate-500 w-32 inline-block">Category</span>
      <% assigned = @registration.provisional_store&.store_category %>
      <%= assigned&.label || @registration.proposed_category&.titleize || StoreRegistration.default_category_code.titleize %>
      <span class="text-xs text-slate-400">(<%= @registration.proposed_category.present? ? "proposed" : "default — set pricing" %>)</span>
    </div>
    <div><span class="text-slate-500 w-32 inline-block">Seller</span><%= @registration.seller&.name %></div>
    <% if @registration.storefront_photo.attached? %>
      <%= image_tag cdn_variant_url(@registration.storefront_photo, resize_to_limit: [400,400]), class: "rounded-lg border border-slate-200 mt-2 max-h-48" %>
    <% end %>
    <% if @registration.provisional_store %>
      <div class="mt-2 rounded bg-amber-50 border border-amber-200 px-3 py-2 text-xs text-amber-800">Ordering already started on provisional code <strong><%= @registration.provisional_store.provisional_code %></strong>.</div>
    <% end %>
  </div>

  <div class="space-y-4">
    <% if @registration.flagged_duplicate? %>
      <div class="rounded-xl border border-red-200 bg-red-50 p-4 text-sm">
        <div class="font-semibold text-red-800 mb-1">Possible duplicate</div>
        <div class="flex flex-wrap gap-1 mb-2"><% Array(@registration.duplicate_flags).each do |f| %><span class="rounded bg-red-100 text-red-700 text-[10px] font-semibold px-1.5 py-0.5"><%= f %></span><% end %></div>
        <% if @registration.duplicate_of_store %>
          <div class="text-red-700">Likely match: <strong><%= @registration.duplicate_of_store.name %></strong> (<%= @registration.duplicate_of_store.code %>)</div>
        <% end %>
      </div>
    <% end %>

    <% if @registration.pending? && can?(:store_registration, :approve) %>
      <div class="rounded-xl border border-slate-200 bg-white p-6">
        <h2 class="text-sm font-semibold mb-3">Approve</h2>
        <%= form_with url: approve_store_registration_path(@registration), method: :post, local: true do %>
          <label class="block text-sm font-medium text-slate-700 mb-1">Permanent store code</label>
          <%= text_field_tag :permanent_code, "", placeholder: "auto-generate if blank", class: "w-full rounded-md border border-slate-300 px-3 py-2 text-sm mb-3" %>

          <div class="grid grid-cols-2 gap-3 mb-3">
            <div>
              <label class="block text-sm font-medium text-slate-700 mb-1">Channel</label>
              <%= select_tag :channel_id,
                    options_from_collection_for_select(Channel.order(:name), :id, :name, @registration.channel_id),
                    include_blank: "— keep —", class: "w-full rounded-md border border-slate-300 px-3 py-2 text-sm" %>
            </div>
            <div>
              <label class="block text-sm font-medium text-slate-700 mb-1">Category <span class="text-xs text-slate-400">→ pricing</span></label>
              <% current_cat = @registration.provisional_store&.store_category&.code %>
              <%= select_tag :category_code,
                    options_for_select(StoreCategory.ordered.map { |c| [c.label, c.code] }, current_cat),
                    include_blank: "— keep default —", class: "w-full rounded-md border border-slate-300 px-3 py-2 text-sm" %>
            </div>
          </div>
          <p class="text-xs text-slate-500 mb-3">Reassigning the category changes the store's price list — it takes effect on the store's next price sync.</p>

          <% seller_routes = Route.where(seller_id: @registration.seller_id).order(:name) %>
          <div class="rounded-lg border border-slate-200 bg-slate-50 p-3 mb-3">
            <div class="text-xs font-semibold text-slate-600 mb-2">Put on route <span class="font-normal text-slate-400">— so it shows on the seller's call list</span></div>
            <div class="grid grid-cols-3 gap-3">
              <div>
                <label class="block text-xs text-slate-600 mb-1">Route</label>
                <%= select_tag :route_id,
                      options_from_collection_for_select(seller_routes, :id, :name, seller_routes.size == 1 ? seller_routes.first.id : @registration.provisional_store&.route_id),
                      include_blank: "— none —", class: "w-full rounded-md border border-slate-300 px-2 py-1.5 text-sm" %>
              </div>
              <div>
                <label class="block text-xs text-slate-600 mb-1">Visit day</label>
                <%= select_tag :visit_day,
                      options_for_select(Store.visit_days.keys.map { |d| [d.titleize, d] }, @registration.enrolled_visit_day),
                      class: "w-full rounded-md border border-slate-300 px-2 py-1.5 text-sm" %>
              </div>
              <div>
                <label class="block text-xs text-slate-600 mb-1">Frequency</label>
                <%= select_tag :visit_frequency,
                      options_for_select([["Weekly (F4)", "f4"], ["Fortnightly (F2)", "f2"]], "f4"),
                      class: "w-full rounded-md border border-slate-300 px-2 py-1.5 text-sm" %>
              </div>
            </div>
            <p class="text-[11px] text-slate-400 mt-2">Visit day defaults to the day it was enrolled (<%= @registration.enrolled_visit_day.titleize %>). F2 auto-uses a fortnightly week pattern.</p>
          </div>
          <% if @registration.duplicate_of_store %>
            <label class="flex items-center gap-2 text-sm text-slate-600 mb-3">
              <%= check_box_tag :duplicate_of_store_id, @registration.duplicate_of_store.id %>
              Treat as duplicate of <%= @registration.duplicate_of_store.name %> (merge, don't create new)
            </label>
          <% end %>
          <%= submit_tag "Approve & activate", class: "rounded-md bg-[#1f4b99] text-white text-sm font-semibold px-4 py-2 hover:bg-[#17386f] cursor-pointer" %>
        <% end %>
      </div>

      <div class="rounded-xl border border-slate-200 bg-white p-6">
        <h2 class="text-sm font-semibold mb-3">Reject</h2>
        <%= form_with url: reject_store_registration_path(@registration), method: :post, local: true do %>
          <%= text_area_tag :rejection_reason, "", rows: 2, placeholder: "Reason (shown to seller)", class: "w-full rounded-md border border-slate-300 px-3 py-2 text-sm mb-3" %>
          <%= submit_tag "Reject", class: "rounded-md border border-red-300 text-red-700 text-sm font-semibold px-4 py-2 hover:bg-red-50 cursor-pointer" %>
        <% end %>
      </div>
    <% else %>
      <div class="rounded-xl border border-slate-200 bg-white p-6 text-sm text-slate-600">
        Status: <strong><%= @registration.status.titleize %></strong><% if @registration.reviewed_at %> · reviewed <%= @registration.reviewed_at.strftime("%d %b %Y %H:%M") %><% end %>
        <% if @registration.rejection_reason.present? %><div class="mt-2 text-red-700">Reason: <%= @registration.rejection_reason %></div><% end %>
      </div>
    <% end %>
    <%= link_to "← Back to approvals", store_registrations_path, class: "text-sm text-[#1f4b99] hover:underline" %>
  </div>
</div>
