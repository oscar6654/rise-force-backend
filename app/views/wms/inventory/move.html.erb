<% content_for :page_title, "Move stock" %>
<div class="rounded-xl border border-slate-200 bg-white p-6 max-w-xl">
  <div class="mb-4 text-sm text-slate-600">
    <div><strong><%= @lot.product.sku %></strong> — <%= @lot.product.description %></div>
    <div class="text-xs text-slate-500 mt-1">
      At <span class="font-mono"><%= @lot.storage_location&.loc_code || "—" %></span>
      · <%= @lot.qty_on_hand.to_i %> pcs on hand · lot <%= @lot.lot_code || "—" %>
    </div>
  </div>
  <%= form_with url: relocate_wms_inventory_path(@lot), method: :post, local: true do |f| %>
    <div class="mb-4">
      <label class="block text-sm font-medium text-slate-700 mb-1">Destination location</label>
      <%= select_tag :to_location_id, options_from_collection_for_select(@locations, :id, ->(l) { "#{l.loc_code} (#{l.loc_type}#{l.pickable? ? ', pickable' : ', not pickable'})" }), include_blank: "—", class: "w-full rounded-md border border-slate-300 px-3 py-2 text-sm", data: { controller: "tom-select" } %>
    </div>
    <div class="mb-4">
      <label class="block text-sm font-medium text-slate-700 mb-1">Qty (pieces — blank = all <%= @lot.qty_on_hand.to_i %>)</label>
      <%= number_field_tag :qty, nil, class: "w-full rounded-md border border-slate-300 px-3 py-2 text-sm", placeholder: @lot.qty_on_hand.to_i %>
    </div>
    <%= submit_tag "Move stock", class: "rounded-md bg-[#1f4b99] text-white text-sm font-semibold px-4 py-2 hover:bg-[#17386f] cursor-pointer" %>
    <%= link_to "Cancel", wms_inventory_index_path, class: "text-sm text-slate-500 hover:underline px-2" %>
  <% end %>
</div>
<p class="mt-3 text-xs text-slate-500 max-w-xl">Use this to pull buffer (non-pickable) stock into a pick slot, consolidate, or re-slot. Moving into a pickable location makes the stock available to FIFO allocation.</p>
