<% content_for :page_title, "Pick jobs" %>
<% content_for :page_actions do %>
  <%= link_to "Upload dispatch CSV", new_import_path("dispatch_orders"), class: "rounded-md border border-slate-300 text-sm font-semibold px-3 py-2 hover:bg-slate-50" if can?(:fulfillment_order, :create) %>
  <% if can?(:fulfillment_order, :update) %>
    <%= button_to "Re-pull SFA orders", build_wms_demand_index_path, class: "rounded-md bg-[#1f4b99] text-white text-sm font-semibold px-3 py-2 hover:bg-[#17386f]" %>
  <% end %>
<% end %>

<form class="mb-3 flex gap-2" method="get">
  <%= select_tag :warehouse_id, options_from_collection_for_select(@warehouses, :id, :whs_code, params[:warehouse_id]), include_blank: "All WMS warehouses", class: "rounded-md border border-slate-300 px-3 py-2 text-sm", onchange: "this.form.submit()" %>
  <%= select_tag :status, options_for_select(FulfillmentOrder.statuses.keys.map { |s| [s.titleize, s] }, params[:status]), include_blank: "All statuses", class: "rounded-md border border-slate-300 px-3 py-2 text-sm", onchange: "this.form.submit()" %>
</form>

<div class="rounded-xl border border-slate-200 bg-white overflow-hidden">
  <table class="w-full border-collapse min-w-[720px]">
    <thead><tr class="bg-slate-50 border-b border-slate-200 text-left text-[11px] uppercase tracking-wide text-slate-500">
      <th class="px-4 py-2.5">WH</th><th class="px-4 py-2.5">Reference</th><th class="px-4 py-2.5">Source</th><th class="px-4 py-2.5">Status</th>
      <th class="px-4 py-2.5">Assigned</th><th class="px-4 py-2.5">Delivery</th><th class="px-4 py-2.5">Lines</th><th></th>
    </tr></thead>
    <tbody>
      <% @orders.each do |fo| %>
        <tr class="border-b border-slate-100 hover:bg-slate-50">
          <td class="px-4 py-2 text-xs text-slate-500"><%= fo.warehouse.whs_code %></td>
          <td class="px-4 py-2 font-mono text-xs"><%= fo.reference_no %></td>
          <td class="px-4 py-2 text-xs"><%= fo.source.titleize %></td>
          <td class="px-4 py-2 text-xs"><%= fo.status.titleize %></td>
          <td class="px-4 py-2 text-xs"><%= fo.assigned_to&.name || "—" %></td>
          <td class="px-4 py-2 text-xs text-slate-500"><%= fo.delivery_date %></td>
          <td class="px-4 py-2 text-sm"><%= fo.fulfillment_lines.size %></td>
          <td class="px-4 py-2 text-right"><%= link_to "View", wms_demand_path(fo), class: "text-sm font-semibold text-[#1f4b99] hover:underline" %></td>
        </tr>
      <% end %>
      <% if @orders.empty? %><tr><td colspan="8" class="px-4 py-8 text-center text-sm text-slate-500">No pick jobs.</td></tr><% end %>
    </tbody>
  </table>
</div>
<div class="mt-3"><%= paginate @orders if respond_to?(:paginate) %></div>
