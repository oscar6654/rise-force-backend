<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="robots" content="index,follow">
  <title><%= content_for?(:title) ? yield(:title) : cfg[:app] %></title>
  <style>
    :root { color-scheme: light dark; }
    * { box-sizing: border-box; }
    body { margin: 0; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
           line-height: 1.6; color: #1f2937; background: #f8fafc; }
    .wrap { max-width: 760px; margin: 0 auto; padding: 28px 20px 64px; }
    header { display: flex; align-items: center; gap: 10px; padding-bottom: 8px; border-bottom: 1px solid #e5e7eb; margin-bottom: 24px; }
    .logo { width: 34px; height: 34px; border-radius: 8px; background: #0F3D2E; color: #F4A81D; display: grid; place-items: center; font-weight: 800; font-size: 14px; }
    h1 { font-size: 26px; margin: 18px 0 6px; }
    h2 { font-size: 18px; margin: 26px 0 6px; }
    p, li { font-size: 15px; }
    a { color: #1f4b99; }
    .muted { color: #6b7280; font-size: 13px; }
    nav a { display: inline-block; margin-right: 14px; font-size: 14px; }
    .card { background: #fff; border: 1px solid #e5e7eb; border-radius: 12px; padding: 18px 20px; margin-top: 16px; }
    @media (prefers-color-scheme: dark) {
      body { background: #0b1220; color: #e5e7eb; }
      .card { background: #111827; border-color: #1f2937; }
      .muted { color: #9ca3af; }
      a { color: #93b4e6; }
    }
  </style>
</head>
<body>
  <div class="wrap">
    <header>
      <div class="logo">RF</div>
      <div>
        <div style="font-weight:700"><%= cfg[:app] %></div>
        <div class="muted">by <%= cfg[:company] %></div>
      </div>
    </header>
    <nav>
      <%= link_to "Privacy", privacy_path %>
      <%= link_to "Terms", terms_path %>
      <%= link_to "Support", support_path %>
      <%= link_to "Data & account deletion", data_deletion_path %>
    </nav>
    <%= yield %>
    <p class="muted" style="margin-top:40px">© <%= Date.current.year %> <%= cfg[:company] %>. <%= cfg[:app] %> is a private business tool for authorized field-sales staff.</p>
  </div>
</body>
</html>
