<%= form_with model: channel, local: true do |f| %>
  <%= render "shared/form_errors", model: channel %>
  <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
    <div>
      <%= f.label :code, class: "block text-sm font-medium text-slate-700 mb-1" %>
      <%= f.text_field :code, class: "w-full rounded-md border border-slate-300 px-3 py-2 text-sm" %>
    </div>
    <div>
      <%= f.label :name, class: "block text-sm font-medium text-slate-700 mb-1" %>
      <%= f.text_field :name, class: "w-full rounded-md border border-slate-300 px-3 py-2 text-sm" %>
    </div>
    <div class="md:col-span-2">
      <%= f.label :description, class: "block text-sm font-medium text-slate-700 mb-1" %>
      <%= f.text_area :description, rows: 2, class: "w-full rounded-md border border-slate-300 px-3 py-2 text-sm" %>
    </div>
    <div>
      <%= f.label :status, class: "block text-sm font-medium text-slate-700 mb-1" %>
      <%= f.select :status, Channel.statuses.keys.map { |s| [s.titleize, s] }, {}, class: "w-full rounded-md border border-slate-300 px-3 py-2 text-sm" %>
    </div>
  </div>
  <div class="mt-5 flex items-center gap-2">
    <%= f.submit(channel.persisted? ? "Save changes" : "Create channel", class: "rounded-md bg-[#1f4b99] text-white text-sm font-semibold px-4 py-2 hover:bg-[#17386f] cursor-pointer") %>
    <%= link_to "Cancel", channels_path, class: "text-sm text-slate-500 hover:underline px-2" %>
  </div>
<% end %>
