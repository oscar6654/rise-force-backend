<%= form_with model: warehouse, local: true do |f| %>
  <%= render "shared/form_errors", model: warehouse %>
  <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
    <div>
      <%= f.label :whs_code, "Warehouse code", class: "block text-sm font-medium text-slate-700 mb-1" %>
      <%= f.text_field :whs_code, class: "w-full rounded-md border border-slate-300 px-3 py-2 text-sm" %>
    </div>
    <div>
      <%= f.label :wh_name, "Warehouse name", class: "block text-sm font-medium text-slate-700 mb-1" %>
      <%= f.text_field :wh_name, class: "w-full rounded-md border border-slate-300 px-3 py-2 text-sm" %>
    </div>
    <div>
      <%= f.label :branch_id, "Branch", class: "block text-sm font-medium text-slate-700 mb-1" %>
      <%= f.collection_select :branch_id, Branch.order(:name), :id, :name, { include_blank: "—" }, class: "w-full rounded-md border border-slate-300 px-3 py-2 text-sm", data: { controller: "tom-select" } %>
    </div>
    <div>
      <%= f.label :status, class: "block text-sm font-medium text-slate-700 mb-1" %>
      <%= f.select :status, Warehouse.statuses.keys.map { |s| [s.titleize, s] }, {}, class: "w-full rounded-md border border-slate-300 px-3 py-2 text-sm" %>
    </div>
    <div class="md:col-span-2">
      <%= f.label :address, class: "block text-sm font-medium text-slate-700 mb-1" %>
      <%= f.text_field :address, class: "w-full rounded-md border border-slate-300 px-3 py-2 text-sm" %>
    </div>
    <div class="md:col-span-2 border-t border-slate-100 pt-4 mt-1">
      <label class="flex items-center gap-2 text-sm font-medium text-slate-700">
        <%= f.check_box :wms_enabled, class: "rounded border-slate-300" %>
        Enable Warehouse Management (WMS) — orders for this warehouse auto-flow to picking
      </label>
    </div>
    <div>
      <%= f.label :allocation_strategy, "Picker assignment", class: "block text-sm font-medium text-slate-700 mb-1" %>
      <%= f.select :allocation_strategy, Warehouse.allocation_strategies.keys.map { |s| [s.titleize, s] }, {}, class: "w-full rounded-md border border-slate-300 px-3 py-2 text-sm" %>
    </div>
    <div>
      <%= f.label :piece_pick_zone, "Piece-pick zone (loose/broken-case area)", class: "block text-sm font-medium text-slate-700 mb-1" %>
      <%= f.text_field :piece_pick_zone, placeholder: "e.g. LOOSE — blank = no case/piece split", class: "w-full rounded-md border border-slate-300 px-3 py-2 text-sm" %>
      <p class="text-[11px] text-slate-400 mt-1">Locations in this zone are picked as loose pieces; everything else is full-case pick. Leave blank to pick cases + pieces together from any bin.</p>
    </div>
  </div>
  <div class="mt-5 flex items-center gap-2">
    <%= f.submit(warehouse.persisted? ? "Save changes" : "Create warehouse", class: "rounded-md bg-[#1f4b99] text-white text-sm font-semibold px-4 py-2 hover:bg-[#17386f] cursor-pointer") %>
    <%= link_to "Cancel", warehouses_path, class: "text-sm text-slate-500 hover:underline px-2" %>
  </div>
<% end %>
