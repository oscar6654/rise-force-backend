<% content_for :page_title, "Return #{@return.ref}" %>
<div class="mb-4 text-sm text-slate-600"><%= @return.warehouse.whs_code %> · store <strong><%= @return.store&.store_code || "—" %></strong> · status <strong><%= @return.status.titleize %></strong></div>

<div class="rounded-xl border border-slate-200 bg-white overflow-hidden">
  <table class="w-full border-collapse min-w-[720px]">
    <thead><tr class="bg-slate-50 border-b border-slate-200 text-left text-[11px] uppercase tracking-wide text-slate-500">
      <th class="px-4 py-2.5">SKU</th><th class="px-4 py-2.5 text-right">Qty</th><th class="px-4 py-2.5">UoM</th><th class="px-4 py-2.5">Disposition &amp; drop</th>
    </tr></thead>
    <tbody>
      <% @return.wms_return_lines.includes(:product).each do |l| %>
        <tr class="border-b border-slate-100">
          <td class="px-4 py-3 font-mono text-xs"><%= l.product&.sku || "—" %><div class="text-slate-400"><%= l.product&.description %></div></td>
          <td class="px-4 py-3 text-right text-sm"><%= l.qty.to_i %></td>
          <td class="px-4 py-3 text-xs"><%= l.pc? ? "pieces" : "cases" %></td>
          <td class="px-4 py-3">
            <% if l.processed? %>
              <span class="rounded-full text-[11px] font-semibold px-2 py-0.5 bg-emerald-100 text-emerald-700"><%= l.disposition&.titleize %></span>
              <span class="text-xs text-slate-500">→ <span class="font-mono"><%= l.storage_location&.loc_code %></span></span>
            <% elsif can?(:wms_return, :update) && l.product %>
              <%= form_with url: process_line_wms_return_path(@return), method: :post, local: true, class: "flex flex-wrap items-center gap-2" do %>
                <%= hidden_field_tag :line_id, l.id %>
                <%= select_tag :disposition,
                      options_for_select([
                        ["Saleable → #{@suggestions.dig(l.id, 'saleable') || 'no slot'}", "saleable"],
                        ["Damaged → #{@suggestions.dig(l.id, 'damaged') || 'no damage zone'}", "damaged"],
                        ["Quarantine → #{@suggestions.dig(l.id, 'quarantine') || 'no damage zone'}", "quarantine"],
                      ]),
                      class: "rounded-md border border-slate-300 px-2 py-1.5 text-sm" %>
                <%= submit_tag "Process", class: "rounded-md bg-emerald-600 text-white text-xs font-semibold px-3 py-1.5 hover:bg-emerald-700 cursor-pointer" %>
              <% end %>
            <% else %>
              <span class="text-xs text-slate-400">unresolved product</span>
            <% end %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
<p class="mt-3 text-xs text-slate-500 max-w-2xl">The system suggests the drop location from the disposition: <b>saleable</b> goes back to stock (the piece zone for loose, else a putaway slot), <b>damaged</b> and <b>quarantine</b> go to the damage zone (excluded from picking). Quantities are received in the line's uom (cases or pieces).</p>
<div class="mt-4"><%= link_to "← Back to returns", wms_returns_path, class: "text-sm text-[#1f4b99] hover:underline" %></div>
